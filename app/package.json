{
  "name": "monodocs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "複数の Markdown / AsciiDoc から単一 HTML / PDF を生成するドキュメントジェネレータ",
  "license": "MIT",
  "author": "kuttsun",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "bundle": "node scripts/bundle.mjs",
    "build:bin": "node scripts/bundle.mjs && node scripts/sea.mjs && node scripts/bin-notices.mjs",
    "package:stage": "pnpm bundle && node scripts/pack.mjs",
    "pack:check": "pnpm package:stage && npm pack --dry-run --json dist/npm/monodocs",
    "package:verify": "pnpm package:stage && node scripts/verify-npm-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:check": "pnpm format:check && pnpm build && pnpm typecheck && pnpm test && pnpm bundle"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
